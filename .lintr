linters: linters_with_defaults(
  line_length_linter = line_length_linter(120),
  cyclocomp_linter = cyclocomp_linter(20),
  object_name_linter = object_name_linter(styles = c("snake_case", "dotted.case"), regexes = "^[JIR]$"),
  T_and_F_symbol_linter = T_and_F_symbol_linter(),
  object_usage_linter = NULL
  )
exclusions: list("R/RcppExports.R", "tests/testthat.R")
